@@ -0,0 +1,64 @@
+import { CommonModule } from '@angular/common';
+import {
+  Component,
+  ElementRef,
+  EventEmitter,
+  Input,
+  OnInit,
+  Output,
+  ViewChild,
+} from '@angular/core';
+import { FormsModule } from '@angular/forms';
+import { TicketCategory } from '@care/portal-domain-tickets';
+import { NzOptionComponent, NzSelectComponent } from 'ng-zorro-antd/select';
+import { fromEvent } from 'rxjs';
+
+/** Bộ lọc theo loại yêu cầu. Phím tắt Alt+L để chọn nhanh. */
+@Component({
+  selector: 'care-category-filter',
+  imports: [CommonModule, FormsModule, NzSelectComponent, NzOptionComponent],
+  template: `
+    <div class="filter-field category-filter" #host>
+      <label for="tk-category-filter">Loại yêu cầu</label>
+      <nz-select
+        nzId="tk-category-filter"
+        nzAllowClear
+        nzPlaceHolder="Tất cả"
+        [ngModel]="value"
+        (ngModelChange)="valueChange.emit($event)"
+      >
+        @for (c of categories; track $index) {
+          <nz-option [nzValue]="c.value" [nzLabel]="c.label" />
+        }
+      </nz-select>
+    </div>
+  `,
+  styles: [
+    `
+      .category-filter label {
+        color: #1677ff;
+        font-weight: 600;
+      }
+    `,
+  ],
+})
+export class CategoryFilter implements OnInit {
+  @Input() value: TicketCategory | null = null;
+  @Output() valueChange = new EventEmitter<TicketCategory | null>();
+  @ViewChild('host', { static: true }) host!: ElementRef<HTMLElement>;
+
+  categories = [
+    { value: 'BILLING', label: 'Cước phí' },
+    { value: 'NETWORK', label: 'Mạng' },
+    { value: 'SERVICE', label: 'Dịch vụ' },
+    { value: 'OTHER', label: 'Khác' },
+  ];
+
+  ngOnInit(): void {
+    fromEvent<KeyboardEvent>(document, 'keydown').subscribe((e) => {
+      if (e.altKey && e.key.toLowerCase() === 'l') {
+        this.host.nativeElement.querySelector('input')?.focus();
+      }
+    });
+  }
+}
