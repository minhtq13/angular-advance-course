+          npm ci
+          npx playwright install --with-deps chromium
+          npx playwright test -c apps/portal-e2e/playwright.smoke.config.mts
+      - name: Log container khi smoke đỏ
+        if: failure()
+        run: docker compose -f infra/docker-compose.yml --profile web logs --tail=200
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: smoke-report-${{ env.WEB_VERSION }}
+          path: frontend/dist/smoke-report
+      # Artifact có version để rollback: tải về rồi docker load. Dự án thật đẩy lên registry (GHCR, Harbor, Nexus).
+      - name: Lưu image
+        run: docker save care-portal-web:$WEB_VERSION | gzip > care-portal-web-$WEB_VERSION.tar.gz
+      - uses: actions/upload-artifact@v4
+        with:
+          name: care-portal-web-${{ env.WEB_VERSION }}
+          path: care-portal-web-*.tar.gz
+          retention-days: 30
diff --git a/.gitlab-ci.yml b/.gitlab-ci.yml
