       - uses: actions/setup-node@v4
         with:
           node-version-file: frontend/.nvmrc
           cache: npm
           cache-dependency-path: frontend/package-lock.json
+      # engine-strict (.npmrc): sai Node thì dừng ở đây, không chờ đến lỗi build khó hiểu.
       - run: npm ci
-      - run: npx nx run-many -t lint
+      - name: Lint, test, build (gồm budget)
+        run: |
+          if [ "${{ github.event_name }}" = pull_request ]; then
+            npx nx affected -t lint test build --base=origin/${{ github.base_ref }} --head=HEAD
+          else
+            npx nx run-many -t lint test build
+          fi
+
+  image:
+    needs: gate
+    if: github.event_name == 'push'
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - name: Version
+        # tag v1.1.0 -> 1.1.0; main -> 0.0.0-main.<commit>. Một version = một image, không build lại khi lên môi trường khác.
+        run: |
+          SHORT=${GITHUB_SHA::7}
+          if [ "$GITHUB_REF_TYPE" = tag ]; then V=${GITHUB_REF_NAME#v}; else V=0.0.0-main.$SHORT; fi
