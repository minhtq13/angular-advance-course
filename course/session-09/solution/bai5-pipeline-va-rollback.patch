index 0000000..8c483b5
--- /dev/null
+++ b/.gitlab-ci.yml
@@ -0,0 +1,63 @@
+# Buổi 9: pipeline tương đương .github/workflows/ci.yml cho GitLab CI.
+#   MR:             gate trên các project bị ảnh hưởng (nx affected).
+#   main, tag v*:   gate đủ -> image có version -> triển khai thử + smoke test -> đẩy image lên registry.
+# Job image/smoke cần runner có Docker và Node (thường là shell runner trên máy ảo nội bộ, tag "docker-host"):
+# smoke dùng chung mạng với container đã triển khai, giống máy học viên.
+
+stages: [gate, image]
+
+workflow:
+  rules:
+    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
+    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
+    - if: $CI_COMMIT_TAG =~ /^v/
+
+variables:
+  NX_DAEMON: 'false'
+  # nx affected so với nhánh đích -> cần lịch sử git.
+  GIT_DEPTH: '0'
+
+gate:
+  stage: gate
+  # Khớp frontend/.nvmrc; engine-strict (.npmrc) chặn nếu lệch.
+  image: node:24.22.0
+  interruptible: true
+  cache:
+    key:
+      files: [frontend/package-lock.json]
+    paths: [.npm/]
+  script:
+    - cd frontend
+    - npm ci --cache ../.npm --prefer-offline
+    - |
+      if [ "$CI_PIPELINE_SOURCE" = merge_request_event ]; then
+        npx nx affected -t lint test build --base="$CI_MERGE_REQUEST_DIFF_BASE_SHA" --head=HEAD
+      else
+        npx nx run-many -t lint test build
+      fi
+
+image:
+  stage: image
+  tags: [docker-host]
+  rules:
+    - if: $CI_PIPELINE_SOURCE != "merge_request_event"
+  script:
+    # tag v1.1.0 -> 1.1.0; main -> 0.0.0-main.<commit>.
+    - export GIT_COMMIT=$CI_COMMIT_SHORT_SHA
+    - export WEB_VERSION=${CI_COMMIT_TAG#v}
+    - '[ -n "$WEB_VERSION" ] || export WEB_VERSION=0.0.0-main.$CI_COMMIT_SHORT_SHA'
+    - docker compose -f infra/docker-compose.yml --profile web build web
+    - docker compose -f infra/docker-compose.yml --profile web up -d --wait web
+    - cd frontend && npm ci && npx playwright install chromium
+    - BASE_URL=http://localhost:8090 EXPECTED_VERSION=$WEB_VERSION npx playwright test -c apps/portal-e2e/playwright.smoke.config.mts
+    # Chỉ đẩy image đã qua smoke. Registry nội bộ: đổi CI_REGISTRY_IMAGE theo hạ tầng.
+    - echo "$CI_REGISTRY_PASSWORD" | docker login -u "$CI_REGISTRY_USER" --password-stdin "$CI_REGISTRY"
+    - docker tag care-portal-web:$WEB_VERSION $CI_REGISTRY_IMAGE/care-portal-web:$WEB_VERSION
+    - docker push $CI_REGISTRY_IMAGE/care-portal-web:$WEB_VERSION
+  after_script:
+    - docker compose -f infra/docker-compose.yml --profile web logs --tail=200 web api
+    - docker compose -f infra/docker-compose.yml --profile web down -v
+  artifacts:
+    when: always
+    paths: [frontend/dist/smoke-report/]
+    expire_in: 30 days
