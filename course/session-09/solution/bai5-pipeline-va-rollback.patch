+# Buổi 9: pipeline đầy đủ.
+#   PR:             gate trên các project bị ảnh hưởng (nx affected) -> nhanh.
+#   main, tag v*:   gate đủ -> image có version -> triển khai thử -> smoke test trên CHÍNH image đó -> lưu image làm artifact.
+# Budget nằm trong target build (apps/portal/project.json): vượt maximumError là build đỏ, không cần bước riêng.
 name: ci
 
 on:
   push:
     branches: [main]
+    tags: ['v*']
   pull_request:
 
+# Push mới lên cùng nhánh thì hủy lần chạy cũ.
+concurrency:
+  group: ci-${{ github.ref }}
+  cancel-in-progress: true
+
 jobs:
-  architecture:
+  gate:
     runs-on: ubuntu-latest
     defaults:
       run:
