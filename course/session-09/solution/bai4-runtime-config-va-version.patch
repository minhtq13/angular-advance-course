+import { ErrorHandler } from '@angular/core';
+import { TestBed } from '@angular/core/testing';
+import { loadAppRelease, provideAppRelease } from './app-release';
+
+function mockFetch(body: string, init: ResponseInit = { status: 200 }) {
+  return vi
+    .spyOn(globalThis, 'fetch')
+    .mockResolvedValue(new Response(body, init));
+}
+
+describe('loadAppRelease', () => {
+  afterEach(() => vi.restoreAllMocks());
+
+  it('doc version va commit tu version.json cua image', async () => {
+    const fetch = mockFetch('{"version":"1.1.0","commit":"3f2c9ab"}');
+
+    await expect(loadAppRelease()).resolves.toEqual({
+      version: '1.1.0',
+      commit: '3f2c9ab',
+    });
+    expect(fetch).toHaveBeenCalledWith('/version.json', { cache: 'no-cache' });
+  });
+
+  it('dev server khong co version.json (tra index.html) -> dev, khong lam hong khoi dong', async () => {
+    mockFetch('<!doctype html><html></html>', {
+      status: 200,
+      headers: { 'content-type': 'text/html' },
+    });
+
+    await expect(loadAppRelease()).resolves.toEqual({
+      version: 'dev',
+      commit: 'local',
+    });
+  });
+
+  it('404 -> dev', async () => {
+    mockFetch('not found', { status: 404 });
+
+    await expect(loadAppRelease()).resolves.toEqual({
+      version: 'dev',
+      commit: 'local',
+    });
+  });
+});
+
+describe('provideAppRelease', () => {
+  it('loi chua bat duoc ghi kem version de loc theo ban phat hanh', () => {
+    const log = vi.spyOn(console, 'error').mockImplementation(() => undefined);
+    TestBed.configureTestingModule({
+      providers: [provideAppRelease({ version: '1.1.0', commit: '3f2c9ab' })],
+    });
+    const error = new TypeError('x is undefined');
+
+    TestBed.inject(ErrorHandler).handleError(error);
+
+    expect(log).toHaveBeenCalledWith('[care-portal 1.1.0 3f2c9ab]', error);
+    log.mockRestore();
+  });
+});
diff --git a/frontend/libs/shared/util-config/src/lib/app-release.ts b/frontend/libs/shared/util-config/src/lib/app-release.ts
new file mode 100644
index 0000000..11c662a
--- /dev/null
+++ b/frontend/libs/shared/util-config/src/lib/app-release.ts
@@ -0,0 +1,42 @@
+import { ErrorHandler, Provider } from '@angular/core';
+
+/**
+ * Bản phát hành đang chạy (buổi 9). Ghi vào image lúc build (version.json), KHÁC config.json:
+ * config theo môi trường (mount lúc chạy), version theo artifact (không đổi khi chuyển môi trường).
+ */
+export interface AppRelease {
+  version: string;
+  commit: string;
+}
+
+const DEV_RELEASE: AppRelease = { version: 'dev', commit: 'local' };
+
+export async function loadAppRelease(
+  url = '/version.json',
+): Promise<AppRelease> {
+  try {
+    const response = await fetch(url, { cache: 'no-cache' });
+    // Dev server không có version.json: trả 404 hoặc index.html (SPA fallback) -> không phải lỗi.
+    return response.ok ? await response.json() : DEV_RELEASE;
+  } catch {
+    return DEV_RELEASE;
+  }
+}
+
+/** Ghi lỗi chưa bắt kèm version + commit: log/kênh quan sát lọc được lỗi theo bản phát hành. */
+class ReleaseErrorHandler extends ErrorHandler {
+  constructor(private readonly release: AppRelease) {
+    super();
+  }
+
+  override handleError(error: unknown): void {
+    console.error(
+      `[care-portal ${this.release.version} ${this.release.commit}]`,
+      error,
+    );
+  }
+}
+
+export function provideAppRelease(release: AppRelease): Provider {
+  return { provide: ErrorHandler, useValue: new ReleaseErrorHandler(release) };
+}
