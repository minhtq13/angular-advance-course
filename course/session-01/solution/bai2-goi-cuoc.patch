index 0000000..9fc423c
--- /dev/null
+++ b/frontend/libs/portal/feature-service-plans/src/lib/service-plan-list/service-plan-list.page.html
@@ -0,0 +1,87 @@
+<div class="page-header">
+  <h1>{{ 'nav.servicePlans' | transloco }}</h1>
+  <span class="muted tabular" role="status"
+    >{{ 'servicePlan.count' | transloco: { count: rows().length } }}</span
+  >
+</div>
+
+<div
+  class="filters"
+  role="search"
+  [attr.aria-label]="'servicePlan.filters' | transloco"
+>
+  <div class="filter-field">
+    <span id="plan-type-label" class="filter-label"
+      >{{ 'servicePlan.type' | transloco }}</span
+    >
+    <nz-radio-group
+      aria-labelledby="plan-type-label"
+      [ngModel]="type()"
+      (ngModelChange)="type.set($event)"
+    >
+      <label nz-radio-button [nzValue]="null"
+        >{{ 'common.all' | transloco }}</label
+      >
+      <label nz-radio-button nzValue="PREPAID"
+        >{{ typeLabels.PREPAID | transloco }}</label
+      >
+      <label nz-radio-button nzValue="POSTPAID"
+        >{{ typeLabels.POSTPAID | transloco }}</label
+      >
+    </nz-radio-group>
+  </div>
+</div>
+
+@if (plans.error()) {
+<nz-alert
+  nzType="error"
+  nzShowIcon
+  [nzMessage]="'servicePlan.loadError' | transloco"
+  [nzAction]="retryTpl"
+  class="mb"
+  role="alert"
+/>
+<ng-template #retryTpl>
+  <button nz-button nzSize="small" (click)="plans.reload()">
+    {{ 'common.retry' | transloco }}
+  </button>
+</ng-template>
+}
+
+<!-- Du lieu nho (vai chuc dong) -> phan trang phia client la du. -->
+<div class="panel">
+  <nz-table
+    nzSize="middle"
+    [nzData]="rows()"
+    [nzLoading]="plans.isLoading()"
+    [nzShowPagination]="false"
+    [nzScroll]="{ x: '640px' }"
+  >
+    <thead>
+      <tr>
+        <th nzWidth="110px">{{ 'servicePlan.col.code' | transloco }}</th>
+        <th>{{ 'servicePlan.col.name' | transloco }}</th>
+        <th nzWidth="120px">{{ 'servicePlan.col.type' | transloco }}</th>
+        <th nzAlign="right" nzWidth="140px">
+          {{ 'servicePlan.col.monthlyFee' | transloco }}
+        </th>
+        <th nzAlign="right" nzWidth="110px">
+          {{ 'servicePlan.col.dataGb' | transloco }}
+        </th>
+      </tr>
+    </thead>
+    <tbody>
+      @for (p of rows(); track p.code) {
+      <tr>
+        <td><nz-tag>{{ p.code }}</nz-tag></td>
+        <td>{{ p.name }}</td>
+        <td>{{ typeLabels[p.type] | transloco }}</td>
+        <td nzAlign="right">
+          {{ p.monthlyFee | translocoCurrency: 'symbol' : {} : 'VND' }}
+        </td>
+        <td nzAlign="right">{{ p.dataGb | translocoDecimal }}</td>
+      </tr>
+      }
+    </tbody>
+  </nz-table>
+</div>
diff --git a/frontend/libs/portal/feature-service-plans/src/lib/service-plan-list/service-plan-list.page.ts b/frontend/libs/portal/feature-service-plans/src/lib/service-plan-list/service-plan-list.page.ts
new file mode 100644
index 0000000..b9b0041
--- /dev/null
+++ b/frontend/libs/portal/feature-service-plans/src/lib/service-plan-list/service-plan-list.page.ts
@@ -0,0 +1,61 @@
+import {
+  ChangeDetectionStrategy,
+  Component,
+  computed,
+  inject,
+  signal,
+} from '@angular/core';
+import { rxResource } from '@angular/core/rxjs-interop';
+import { FormsModule } from '@angular/forms';
+import {
+  ServicePlanApi,
+  SUBSCRIBER_TYPE,
+  SubscriberType,
+} from '@care/shared-data-access-api';
+import { TranslocoPipe } from '@jsverse/transloco';
+import {
+  TranslocoCurrencyPipe,
+  TranslocoDecimalPipe,
+} from '@jsverse/transloco-locale';
+import { NzAlertComponent } from 'ng-zorro-antd/alert';
+import { NzButtonComponent } from 'ng-zorro-antd/button';
+import { NzRadioComponent, NzRadioGroupComponent } from 'ng-zorro-antd/radio';
+import { NzTableModule } from 'ng-zorro-antd/table';
+import { NzTagComponent } from 'ng-zorro-antd/tag';
+
+@Component({
+  selector: 'care-service-plan-list-page',
+  imports: [
+    FormsModule,
+    TranslocoPipe,
+    TranslocoCurrencyPipe,
+    TranslocoDecimalPipe,
+    NzAlertComponent,
+    NzButtonComponent,
+    NzRadioGroupComponent,
+    NzRadioComponent,
+    NzTableModule,
+    NzTagComponent,
+  ],
+  templateUrl: './service-plan-list.page.html',
+  changeDetection: ChangeDetectionStrategy.OnPush,
+})
+export class ServicePlanListPage {
+  private readonly api = inject(ServicePlanApi);
+
+  protected readonly typeLabels = SUBSCRIBER_TYPE;
+
+  /** null = tat ca loai. */
+  protected readonly type = signal<SubscriberType | null>(null);
+
+  // Luu y: params() tra ve undefined => resource o trang thai idle, KHONG goi API.
+  // Vi vay boc trong object thay vi tra ve this.type() ?? undefined.
+  protected readonly plans = rxResource({
+    params: () => ({ type: this.type() }),
+    stream: ({ params }) => this.api.list(params.type ?? undefined),
+  });
+
+  protected readonly rows = computed(() =>
+    this.plans.hasValue() ? this.plans.value() : [],
+  );
+}
