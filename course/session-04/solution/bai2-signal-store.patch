+++ b/frontend/libs/portal/feature-tickets/src/lib/ticket-list/ticket-list.store.spec.ts
@@ -0,0 +1,76 @@
+import { signal } from '@angular/core';
+import { TestBed } from '@angular/core/testing';
+import { TicketPort } from '@care/portal-domain-tickets';
+import {
+  aTicket,
+  InMemoryTicketAdapter,
+} from '@care/portal-domain-tickets/testing';
+import { AuthService } from '@care/shared-data-access-auth';
+import { throwError } from 'rxjs';
+import { TicketListStore } from './ticket-list.store';
+
+describe('TicketListStore', () => {
+  let port: InMemoryTicketAdapter;
+
+  function setup() {
+    port = new InMemoryTicketAdapter().seed([
+      aTicket({ status: 'NEW', assignee: 'agent1' }),
+      aTicket({ status: 'RESOLVED', assignee: 'agent2' }),
+    ]);
+    TestBed.configureTestingModule({
+      providers: [
+        TicketListStore,
+        { provide: TicketPort, useValue: port },
+        { provide: AuthService, useValue: { username: signal('agent1') } },
+      ],
+    });
+    const store = TestBed.inject(TicketListStore);
+    TestBed.tick();
+    return store;
+  }
+
+  it('tai trang dau khi khoi tao', () => {
+    const store = setup();
+    expect(port.calls).toHaveLength(1);
+    expect(store.items()).toHaveLength(2);
+    expect(store.status()).toBe('done');
+  });
+
+  it('doi bo loc -> ve trang 0, giu kich thuoc trang, tai lai mot lan', () => {
+    const store = setup();
+    store.setPage({ page: 3, size: 50, sort: 'id,desc' });
+    TestBed.tick();
+    store.setFilters({ status: 'RESOLVED', onlyMine: true });
+    TestBed.tick();
+
+    expect(port.calls.at(-1)).toEqual({
+      query: { status: 'RESOLVED', priority: null, assignee: 'agent1' },
+      page: { page: 0, size: 50, sort: 'id,desc' },
+    });
+    expect(port.calls).toHaveLength(3);
+  });
+
+  it('setPage cung trang khong goi API lai', () => {
+    const store = setup();
+    store.setPage({ ...store.page() });
+    TestBed.tick();
+    expect(port.calls).toHaveLength(1);
+  });
+
+  it('API loi -> status error, reload dung query cu thi tai lai duoc', () => {
+    const store = setup();
+    const search = vi.spyOn(port, 'search');
+    search.mockReturnValueOnce(throwError(() => new Error('500')));
+    store.setFilters({ priority: 'HIGH' });
+    TestBed.tick();
+    expect(store.status()).toBe('error');
+
+    store.reload();
+    expect(store.status()).toBe('done');
+    expect(search.mock.calls.at(-1)?.[0]).toEqual({
+      status: null,
+      priority: 'HIGH',
+      assignee: null,
+    });
+  });
+});
diff --git a/frontend/libs/portal/feature-tickets/src/lib/ticket-list/ticket-list.store.ts b/frontend/libs/portal/feature-tickets/src/lib/ticket-list/ticket-list.store.ts
new file mode 100644
index 0000000..af4f342
--- /dev/null
+++ b/frontend/libs/portal/feature-tickets/src/lib/ticket-list/ticket-list.store.ts
@@ -0,0 +1,123 @@
+import { computed, inject } from '@angular/core';
+import {
+  TicketPort,
+  TicketPriority,
+  TicketQuery,
+  TicketStatus,
+  TicketSummary,
+} from '@care/portal-domain-tickets';
+import {
+  DEFAULT_PAGE,
+  PageRequest,
+  samePage,
+} from '@care/shared-data-access-api';
+import { AuthService } from '@care/shared-data-access-auth';
+import {
+  patchState,
+  signalStore,
+  withComputed,
+  withHooks,
+  withMethods,
+  withState,
+} from '@ngrx/signals';
+import { rxMethod } from '@ngrx/signals/rxjs-interop';
+import { catchError, EMPTY, pipe, switchMap, tap } from 'rxjs';
+
+export interface TicketFilters {
+  status: TicketStatus | null;
+  priority: TicketPriority | null;
+  onlyMine: boolean;
+}
+
+export const NO_FILTERS: TicketFilters = {
+  status: null,
+  priority: null,
+  onlyMine: false,
+};
+
+interface TicketListState {
+  filters: TicketFilters;
+  page: PageRequest;
+  items: TicketSummary[];
+  total: number;
+  status: 'loading' | 'done' | 'error';
+}
+
+/**
+ * State cua man hinh danh sach phieu: bo loc, trang, ket qua tu server.
+ * Cung cap o component (providers: [TicketListStore]) -> moi lan vao man hinh la mot store moi.
+ */
+export const TicketListStore = signalStore(
+  withState<TicketListState>({
+    filters: NO_FILTERS,
+    page: DEFAULT_PAGE,
+    items: [],
+    total: 0,
+    status: 'loading',
+  }),
+  withComputed(({ filters }, auth = inject(AuthService)) => ({
+    query: computed((): TicketQuery => ({
+      status: filters.status(),
+      priority: filters.priority(),
+      assignee: filters.onlyMine() ? auth.username() : null,
+    })),
+    hasFilters: computed(
+      () =>
+        filters.status() !== null ||
+        filters.priority() !== null ||
+        filters.onlyMine(),
+    ),
+  })),
+  withMethods((store, tickets = inject(TicketPort)) => {
+    // switchMap: doi bo loc nhanh thi huy request cu (buoi 3). catchError ben trong: loi khong lam chet luong.
+    const load = rxMethod<{ query: TicketQuery; page: PageRequest }>(
+      pipe(
+        tap(() => patchState(store, { status: 'loading' })),
+        switchMap(({ query, page }) =>
+          tickets.search(query, page).pipe(
+            tap(({ items, total }) =>
+              patchState(store, { items, total, status: 'done' }),
+            ),
+            catchError(() => {
+              patchState(store, { status: 'error' });
+              return EMPTY;
+            }),
+          ),
+        ),
+      ),
+    );
+
+    return {
+      /** Doi bo loc -> ve trang dau, giu kich thuoc trang va sort. */
+      setFilters(change: Partial<TicketFilters>): void {
+        patchState(store, (s) => ({
+          filters: { ...s.filters, ...change },
+          page: { ...s.page, page: 0 },
+        }));
+      },
+      clearFilters(): void {
+        patchState(store, (s) => ({
+          filters: NO_FILTERS,
+          page: { ...s.page, page: 0 },
+        }));
+      },
+      setPage(page: PageRequest): void {
+        // nz-table phat lai cung trang khi khoi tao: bo qua de khong goi API trung.
+        if (!samePage(page, store.page())) patchState(store, { page });
+      },
+      /** Tai lai dung query va trang hien tai (nut Thu lai, sau khi duyet). */
+      reload(): void {
+        load({ query: store.query(), page: store.page() });
+      },
+      _load: load,
+    };
+  }),
+  withHooks({
+    onInit(store) {
+      // Truyen signal vao rxMethod: moi lan query/trang doi la tai lai.
+      store._load(
+        computed(() => ({ query: store.query(), page: store.page() })),
+      );
+    },
+  }),
+);
