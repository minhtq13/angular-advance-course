@@ -0,0 +1,23 @@
+import { TicketStatus } from './ticket';
+import { canApprove } from './ticket.rules';
+
+describe('canApprove', () => {
+  // Đủ 4 trạng thái x 3 nhóm vai trò: thiếu một ô là chỗ lỗi dễ lọt.
+  it.each<[TicketStatus, string[], boolean]>([
+    ['RESOLVED', ['AGENT', 'SUPERVISOR'], true],
+    ['RESOLVED', ['SUPERVISOR'], true],
+    ['RESOLVED', ['AGENT'], false],
+    ['RESOLVED', [], false],
+    ['NEW', ['SUPERVISOR'], false],
+    ['IN_PROGRESS', ['SUPERVISOR'], false],
+    ['CLOSED', ['SUPERVISOR'], false],
+    ['NEW', ['AGENT'], false],
+  ])('phieu %s, vai tro %j -> %s', (status, roles, expected) => {
+    expect(canApprove({ status }, roles)).toBe(expected);
+  });
+
+  it('khong nham ten vai tro gan giong (supervisor viet thuong, SUPERVISOR_X)', () => {
+    expect(canApprove({ status: 'RESOLVED' }, ['supervisor'])).toBe(false);
+    expect(canApprove({ status: 'RESOLVED' }, ['SUPERVISOR_X'])).toBe(false);
+  });
+});
diff --git a/frontend/libs/portal/domain-tickets/src/lib/ticket.rules.ts b/frontend/libs/portal/domain-tickets/src/lib/ticket.rules.ts
new file mode 100644
index 0000000..952d708
--- /dev/null
+++ b/frontend/libs/portal/domain-tickets/src/lib/ticket.rules.ts
@@ -0,0 +1,13 @@
+import { TicketSummary } from './ticket';
+
+/**
+ * Quy tắc hiện nút Duyệt: Manager (SUPERVISOR) và phiếu đã xử lý (RESOLVED).
+ * Chỉ là trải nghiệm: quyền thật do API kiểm tra (agent gọi thẳng API vẫn nhận 403).
+ * Hàm thuần, không phụ thuộc Angular -> test bằng bảng, chạy trong vài mili giây.
+ */
+export function canApprove(
+  ticket: Pick<TicketSummary, 'status'>,
+  roles: readonly string[],
+): boolean {
+  return roles.includes('SUPERVISOR') && ticket.status === 'RESOLVED';
+}
