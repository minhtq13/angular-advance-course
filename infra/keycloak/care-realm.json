{
  "realm": "care",
  "displayName": "Care Portal",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "vi",
    "en"
  ],
  "defaultLocale": "vi",
  "roles": {
    "realm": [
      {
        "name": "AGENT",
        "description": "Nhân viên CSKH"
      },
      {
        "name": "SUPERVISOR",
        "description": "Trưởng ca, duyệt phiếu"
      },
      {
        "name": "ADMIN",
        "description": "Quản trị"
      }
    ]
  },
  "users": [
    {
      "username": "agent1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Agent",
      "lastName": "One",
      "email": "agent1@care.local",
      "credentials": [
        {
          "type": "password",
          "value": "agent1",
          "temporary": false
        }
      ],
      "realmRoles": [
        "AGENT"
      ]
    },
    {
      "username": "supervisor1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Supervisor",
      "lastName": "One",
      "email": "supervisor1@care.local",
      "credentials": [
        {
          "type": "password",
          "value": "supervisor1",
          "temporary": false
        }
      ],
      "realmRoles": [
        "AGENT",
        "SUPERVISOR"
      ]
    },
    {
      "username": "admin1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "One",
      "email": "admin1@care.local",
      "credentials": [
        {
          "type": "password",
          "value": "admin1",
          "temporary": false
        }
      ],
      "realmRoles": [
        "AGENT",
        "SUPERVISOR",
        "ADMIN"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "care-portal",
      "name": "Care Portal (SPA)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "http://localhost:4200/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/login"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email",
        "basic"
      ],
      "optionalClientScopes": [
        "offline_access"
      ],
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience care-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "care-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ]
}
