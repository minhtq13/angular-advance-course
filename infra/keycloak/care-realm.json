{
  "realm": "care",
  "enabled": true,
  "displayName": "Care Portal",
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      {
        "name": "AGENT",
        "description": "Nhân viên CSKH"
      },
      {
        "name": "SUPERVISOR",
        "description": "Giám sát viên"
      },
      {
        "name": "ADMIN",
        "description": "Quản trị hệ thống"
      }
    ]
  },
  "clients": [
    {
      "clientId": "care-portal",
      "name": "care-portal",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      }
    },
    {
      "clientId": "care-admin",
      "name": "care-admin",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:4300/*"
      ],
      "webOrigins": [
        "http://localhost:4300"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4300/*"
      }
    },
    {
      "clientId": "care-dev-cli",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false
    }
  ],
  "users": [
    {
      "username": "agent1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Agent",
      "lastName": "One",
      "email": "agent1@care.local",
      "credentials": [
        {
          "type": "password",
          "value": "agent1",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-care",
        "AGENT"
      ]
    },
    {
      "username": "supervisor1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Supervisor",
      "lastName": "One",
      "email": "supervisor1@care.local",
      "credentials": [
        {
          "type": "password",
          "value": "supervisor1",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-care",
        "AGENT",
        "SUPERVISOR"
      ]
    },
    {
      "username": "admin1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "One",
      "email": "admin1@care.local",
      "credentials": [
        {
          "type": "password",
          "value": "admin1",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-care",
        "AGENT",
        "SUPERVISOR",
        "ADMIN"
      ]
    }
  ]
}